{
  "name": "@dashkite/sublime",
  "version": "0.2.1",
  "description": "Canonical HTTP request and response format, with accessors and mutators",
  "keywords": [],
  "homepage": "https://github.com/dashkite/sublime#readme",
  "bugs": {
    "url": "https://github.com/dashkite/sublime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashkite/sublime.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "contributors": [
    "Dan Yoder <dan@dashkite.com>",
    "David Harper <david@dashkite.com>",
    "Chand Rajendra-Nicolucci <chand@dashkite.com>"
  ],
  "exports": {
    ".": {
      "browser": "./build/browser/src/index.js",
      "node": "./build/node/src/index.js"
    },
    "./request": {
      "browser": "./build/browser/src/request/index.js",
      "node": "./build/node/src/request/index.js"
    },
    "./request/*": {
      "browser": "./build/browser/src/request/*.js",
      "node": "./build/node/src/request/*.js"
    },
    "./response": {
      "browser": "./build/browser/src/response/index.js",
      "node": "./build/node/src/response/index.js"
    },
    "./response/*": {
      "browser": "./build/browser/src/response/*.js",
      "node": "./build/node/src/response/*.js"
    },
    "./convert": {
      "browser": "./build/browser/src/convert/index.js",
      "node": "./build/node/src/convert/index.js"
    },
    "./state": {
      "browser": "./build/browser/src/state/index.js",
      "node": "./build/node/src/state/index.js"
    },
    "./xurl": {
      "browser": "./build/browser/src/xurl/index.js",
      "node": "./build/node/src/xurl/index.js"
    }
  },
  "imports": {
    "#helpers/*": {
      "browser": "./build/browser/src/helpers/*.js",
      "node": "./build/node/src/helpers/*.js"
    },
    "#fields": {
      "browser": "./build/browser/src/fields/index.js",
      "node": "./build/node/src/fields/index.js"
    },
    "#content/*": {
      "browser": "./build/browser/src/content/*.js",
      "node": "./build/node/src/content/*.js"
    },
    "#builder": {
      "browser": "./build/browser/src/builder/index.js",
      "node": "./build/node/src/builder/index.js"
    },
    "#state": {
      "browser": "./build/browser/src/state/index.js",
      "node": "./build/node/src/state/index.js"
    },
    "#request": {
      "browser": "./build/browser/src/request/index.js",
      "node": "./build/node/src/request/index.js"
    },
    "#request/*": {
      "browser": "./build/browser/src/request/*.js",
      "node": "./build/node/src/request/*.js"
    },
    "#response": {
      "browser": "./build/browser/src/response/index.js",
      "node": "./build/node/src/response/index.js"
    },
    "#response/*": {
      "browser": "./build/browser/src/response/*.js",
      "node": "./build/node/src/response/*.js"
    },
    "#xurl": {
      "browser": "./build/browser/src/xurl/index.js",
      "node": "./build/node/src/xurl/index.js"
    }
  },
  "files": [
    "build/browser/src",
    "build/node/src"
  ],
  "scripts": {
    "test": "genie test",
    "build": "genie build",
    "release": "genie release"
  },
  "devDependencies": {
    "@dashkite/amen": "^0.9.16",
    "@dashkite/amen-console": "^0.8.14",
    "@dashkite/assert": "^0.7.19",
    "@dashkite/genie": "0.20.4",
    "@dashkite/genie-clean": "0.13.1",
    "@dashkite/genie-coffee": "0.13.1",
    "@dashkite/genie-module": "^0.5.43",
    "@dashkite/genie-release": "^0.5.2",
    "@dashkite/genie-yaml": "0.11.1",
    "@dashkite/runner": "^0.1.13"
  },
  "dependencies": {
    "@dashkite/athena": "link:../athena",
    "@dashkite/generic": "0.9.1",
    "@dashkite/http-headers": "^0.12.38",
    "@dashkite/joy": "^0.12.26",
    "@dashkite/media-type": "^0.9.0",
    "@dashkite/reactive": "^0.7.22",
    "@dashkite/registry": "^0.17.13",
    "@dashkite/sierra": "^0.3.18",
    "statuses": "^2.0.2"
  }
}
